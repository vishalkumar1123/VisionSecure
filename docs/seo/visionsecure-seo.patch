+ let fail=true;await page.route('**/api/leads',route=>route.fulfill({status:fail?409:200,contentType:'application/json',body:JSON.stringify(fail?{success:false,error:'Duplicate fixture'}:{success:true,leadId:'fixture'})}))
+ await page.goto(base+'/');const popup=page.getByRole('dialog');await expect(popup).toBeVisible({timeout:15000})
+ await popup.locator('input').first().fill('Browser fixture');await popup.locator('input[type="tel"]').fill('9876543210');await page.locator('#popup-service').click();await page.getByRole('option',{name:'CCTV Surveillance',exact:true}).click()
+ let dialog=page.waitForEvent('dialog').then(d=>d.accept());await popup.getByRole('button',{name:'Submit enquiry'}).click();await dialog;await expect(popup.locator('input').first()).toHaveValue('Browser fixture')
