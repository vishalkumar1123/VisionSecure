+﻿from pathlib import Path
+import json,csv,re,datetime
+out=Path('docs/seo');pages=json.loads((out/'local-pages.json').read_text());origin='https://visionsecuretech.in';date='2026-10-19'
+p1=['/','/contact','/services/cctv-surveillance','/services/biometric-attendance','/services/networking-solutions','/services/it-support-amc']
+def priority(p):return 'P1' if p in p1 else ('P3' if p.startswith('/blog/') or p in ['/gallery','/faq'] else 'P2')
+def save(name,rows):
+ with (out/name).open('w',newline='',encoding='utf-8-sig') as f:w=csv.DictWriter(f,fieldnames=list(rows[0]));w.writeheader();w.writerows(rows)
+save('public-url-inventory.csv',[dict(absolute_canonical_url=origin+p['path'],source=p['source'],page_type=p['type'],primary_topic=p['intent'],intended_location='Lucknow' if p['type']=='service' or p['path'] in ['/','/about','/contact','/services','/projects'] else 'Not location-specific',implemented_title=p['title'],implemented_description=p['description'],implemented_main_heading=p['heading'],implemented_canonical=origin+(p['path'] if p['path']!='/' else ''),declared_robots='index, follow',intended_indexability='Index',included_in_sitemap='Yes',recommended_primary_search_intent=p['intent'],remaining_issue='Deploy and inspect in Search Console; owner confirm business facts' if p['path'] in ['/','/contact'] else 'Deploy and inspect in Search Console',priority=priority(p['path']),verification_method='Local implemented values; rendered checks in local-render-checks.json; production recorded separately',verification_date=date,value_scope='Local implementation; not deployed') for p in pages])
+save('priority-page-map.csv',[dict(existing_url=origin+p['path'],recommended_primary_search_intent=p['intent'],supporting_topics='Selection, compatibility, site requirements, installation, handover and maintenance scope' if p['type']=='service' else ('Educational equipment comparison and practical guidance' if p['type']=='blog' else p['description']),implemented_title=p['title'],implemented_heading=p['heading'],content_improvements='Distinct selection/handover guidance and quotation scope; existing FAQs retained' if p['type']=='service' else ('Article-specific metadata and contextual service links' if p['type']=='blog' else 'Stable heading and page-specific canonical metadata'),related_internal_links='/services; /contact' if p['type']!='service' else '/services; three related service pages; /contact',enquiry_destination='/contact?service='+p['path'].split('/')[-1] if p['type']=='service' else ('/contact' if p['path'] not in ['/faq','/blog'] else 'Contextual service links'),priority=priority(p['path']),implementation_status='Implemented locally; deployment and account verification pending') for p in pages])
+non=[]
+for p in sorted(Path('app').rglob('*')):
+ if p.name not in ['page.tsx','route.ts']:continue
+ route='/'+ '/'.join(x for x in p.parent.parts[1:] if not x.startswith('('))
+ if route in [x['path'] for x in pages] or route in ['/blog/[slug]','/services/[slug]']:continue
+ category='API endpoint' if route.startswith('/api/') else ('Utility POST compatibility endpoint' if route=='/inquiry' else ('Admin/account' if route.startswith('/admin') else 'Account'))
+ non.append(dict(route_pattern=route,category=category,source=str(p).replace('\\','/'),intended_treatment='Excluded from sitemap; authentication/authorization retained; private page responses carry noindex' if category in ['Admin/account','Account'] else 'Excluded from sitemap; no public indexing intended; existing access checks retained',runtime_only_pattern='Yes; no private IDs enumerated' if '[' in route else 'No'))
+non.extend([dict(route_pattern='/blog/[slug]',category='Public dynamic route with seven known slugs',source='lib/blogs.ts',intended_treatment='Only real catalogue slugs included; unknown slug returns 404',runtime_only_pattern='No; catalogue resolved'),dict(route_pattern='/services/[slug]',category='Public dynamic route with thirteen known slugs',source='lib/services.ts',intended_treatment='Only real catalogue slugs included; unknown slug returns 404',runtime_only_pattern='No; catalogue resolved'),dict(route_pattern='https://www.visionsecuretech.in/:path*',category='Permanent redirect',source='next.config.mjs',intended_treatment='308 to same path on https://visionsecuretech.in; query preserved',runtime_only_pattern='No')])
+for route,source in [('/robots.txt','app/robots.ts'),('/sitemap.xml','app/sitemap.ts'),('/_not-found','Next.js generated error route')]:non.append(dict(route_pattern=route,category='Metadata/error utility',source=source,intended_treatment='Not a public content landing page; excluded from sitemap',runtime_only_pattern='No'))
+save('non-indexable-routes.csv',non)
+print('Reports:',len(pages),'public pages;',len(non),'non-indexable/pattern/redirect rows')
