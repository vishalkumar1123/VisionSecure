@@ -0,0 +1,111 @@
+/* Admin-only palette and surfaces. Public routes and the sign-in page keep their own theme. */
+.admin-shell, .admin-dialog {
+  --background: #eef3ef;
+  --foreground: #182f27;
+  --card: #fcfefd;
+  --card-foreground: #182f27;
+  --popover: #fcfefd;
+  --popover-foreground: #182f27;
+  --secondary: #e6eee8;
+  --secondary-foreground: #182f27;
+  --muted: #e4ece6;
+  --muted-foreground: #54695d;
+  --primary: #214e3b;
+  --primary-foreground: #ffffff;
+  --accent: #79c914;
+  --accent-foreground: #142a1c;
+  --brand-ink: #214e3b;
+  --brand-green: #426d1c;
+  --highlight: #28835b;
+  --highlight-ink: #276846;
+  --border: #d3e0d6;
+  --input: #bacdbf;
+  --ring: #4b8a50;
+  --sidebar: #f3f7f2;
+  --chart-1: #367353;
+  --chart-2: #79b931;
+  --chart-3: #369994;
+  --chart-4: #af7b3d;
+  --chart-5: #8672ad;
+  --admin-solid: #f8fbf7;
+  --admin-glass: rgba(250, 253, 248, .83);
+  --admin-shadow: 0 14px 40px -26px #254b3e55, inset 0 1px 0 #ffffff;
+  color: var(--foreground);
+}
+.dark .admin-shell, .dark .admin-dialog {
+  --background: #0d1915;
+  --foreground: #eaf3ec;
+  --card: #192b23;
+  --card-foreground: #eaf3ec;
+  --popover: #20372c;
+  --popover-foreground: #eaf3ec;
+  --secondary: #17271f;
+  --secondary-foreground: #eaf3ec;
+  --muted: #273d30;
+  --muted-foreground: #acbeb1;
+  --primary: #b3df92;
+  --primary-foreground: #112218;
+  --brand-ink: #c5e7ae;
+  --brand-green: #b3df92;
+  --highlight: #a3d586;
+  --highlight-ink: #b3df92;
+  --border: #354b3d;
+  --input: #526b57;
+  --ring: #b3df92;
+  --sidebar: #14241c;
+  --chart-1: #b3df92;
+  --chart-2: #7dbd56;
+  --chart-3: #69bab2;
+  --chart-4: #d9ad74;
+  --chart-5: #b3a1d1;
+  --admin-solid: #192b23;
+  --admin-glass: rgba(25, 43, 35, .87);
+  --admin-shadow: 0 18px 44px -26px #0009, inset 0 1px 0 #ceeec214;
+}
+.admin-shell { position: relative; isolation: isolate; min-height: 100vh; background: var(--background); }
+.admin-shell::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(ellipse at 8% 0%, #79c91416, transparent 45%), radial-gradient(ellipse at 98% 25%, #41967b14, transparent 50%); }
+.admin-main { position: relative; }
+.admin-glass, .admin-toolbar, .admin-sidebar {
+  background: var(--admin-solid);
+  border: 1px solid var(--border);
+  box-shadow: var(--admin-shadow);
+}
+@supports ((backdrop-filter: blur(8px)) or (-webkit-backdrop-filter: blur(8px))) {
+  .admin-glass, .admin-toolbar, .admin-sidebar { background: var(--admin-glass); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
+}
+.admin-glass { border-radius: 22px; }
+.admin-toolbar { border-radius: 20px; }
+.admin-sidebar { border-radius: 24px; }
+.admin-navigation-drawer .admin-sidebar { border: 0; border-radius: 0; height: 100%; box-shadow: none; }
+.admin-navigation-drawer { background: var(--admin-solid); color: var(--foreground); }
+.admin-sidebar nav > a { position: relative; min-height: 46px; border: 1px solid transparent; transition: background-color 160ms, border-color 160ms, color 160ms; }
+.admin-sidebar nav a[aria-current="page"] { background: var(--muted); border-color: var(--border); color: var(--foreground); box-shadow: inset 3px 0 0 var(--accent); }
+.admin-sidebar nav > a[aria-current="page"] svg { color: var(--brand-green); }
+.admin-sidebar nav details { background: var(--card); border-color: var(--border); border-radius: 15px; }
+.admin-sidebar nav summary { min-height: 44px; }
+.admin-sidebar nav details a { min-height: 40px; }
+.admin-sidebar .admin-sidebar-brand { background: #ffffff; border: 1px solid #ffffff80; box-shadow: 0 4px 18px -12px #152e25; }
+.admin-shell :where(a, button, input, select, textarea, summary):focus-visible, .admin-dialog :where(a, button, summary):focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }
+.admin-shell input, .admin-shell textarea, .admin-shell select { background-color: var(--card); color: var(--foreground); }
+.admin-shell table { background: var(--card); }
+.admin-shell th { color: var(--muted-foreground); }
+.admin-shell .admin-kpi { position: relative; overflow: hidden; transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
+.admin-shell .admin-kpi:hover { transform: translateY(-3px); border-color: var(--ring); box-shadow: 0 20px 34px -24px #17372166, inset 0 1px 0 #ffffff22; }
+.admin-shell .admin-kpi:active { transform: translateY(-1px); }
+.admin-kpi-icon { border: 1px solid var(--border); background: linear-gradient(145deg, var(--muted), var(--card)); box-shadow: inset 0 1px 0 #ffffff25, 0 3px 7px -5px #0008; }
+.admin-shell .admin-overview-header { background-image: linear-gradient(115deg, #79c9140e, transparent 65%); }
+.admin-shell [data-testid="dashboard-clock"] { width: auto; flex-shrink: 0; max-width: 160px; gap: 4px; }
+.admin-shell [data-testid="dashboard-clock"] > svg { width: 82px; height: 82px; }
+.admin-shell [data-testid="dashboard-clock"] > p { font-size: 10px; max-width: 145px; }
+.admin-shell [data-testid="dashboard-clock"] > span { font-size: 8px; letter-spacing: .08em; }
+.admin-expandable[open] > .admin-expandable-content { animation: admin-panel-in 160ms ease-out both; }
+@keyframes admin-panel-in { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: translateY(0); } }
+@media (min-width: 640px) { .admin-shell [data-testid="dashboard-clock"] > svg { width: 96px; height: 96px; } }
+@media (max-width: 420px) { .admin-shell [data-testid="dashboard-clock"] > svg { width: 64px; height: 64px; } .admin-shell [data-testid="dashboard-clock"] { max-width: 106px; } }
+@media (prefers-reduced-motion: reduce) {
+  .admin-shell *, .admin-shell *::before, .admin-shell *::after, .admin-dialog *, .admin-dialog *::before, .admin-dialog *::after { animation-duration: 0s !important; transition-duration: 0s !important; scroll-behavior: auto !important; }
+  .admin-shell .admin-kpi:hover, .admin-shell .admin-kpi:active { transform: none; }
+}
+
+/* Keep toolbar popovers above the backdrop-filter stacking contexts below. */
+.admin-toolbar { position: relative; z-index: 20; }
