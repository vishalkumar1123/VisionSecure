diff --git a/app/admin/admin-glass.css b/app/admin/admin-glass.css
index 7f2ee15..c02bcf2 100644
--- a/app/admin/admin-glass.css
+++ b/app/admin/admin-glass.css
@@ -1,6 +1,6 @@
 /* Admin-only palette and surfaces. Public routes and the sign-in page keep their own theme. */
 .admin-shell, .admin-dialog {
-  --background: #eef3ef;
+  --background: #edf2f8;
   --foreground: #182f27;
   --card: #fcfefd;
   --card-foreground: #182f27;
@@ -28,8 +28,10 @@
   --chart-4: #af7b3d;
   --chart-5: #8672ad;
   --admin-solid: #f8fbf7;
-  --admin-glass: rgba(250, 253, 248, .83);
-  --admin-shadow: 0 14px 40px -26px #254b3e55, inset 0 1px 0 #ffffff;
+  --admin-glass: rgba(248, 252, 255, .60);
+  --admin-glass-edge: rgba(255, 255, 255, .82);
+  --admin-glass-sheen: rgba(255, 255, 255, .48);
+  --admin-shadow: 0 16px 40px -24px #203e6350, inset 0 1px 0 #ffffff, inset 0 -1px 0 #ffffff40;
   color: var(--foreground);
 }
 .dark .admin-shell, .dark .admin-dialog {
@@ -59,13 +61,17 @@
   --chart-4: #d9ad74;
   --chart-5: #b3a1d1;
   --admin-solid: #1b2635;
-  --admin-glass: rgba(27, 38, 53, .91);
-  --admin-shadow: 0 18px 44px -26px #0009, inset 0 1px 0 #d9e8ff14;
+  --admin-glass: rgba(23, 35, 53, .56);
+  --admin-glass-edge: rgba(185, 210, 244, .20);
+  --admin-glass-sheen: rgba(211, 230, 255, .065);
+  --admin-shadow: 0 20px 45px -25px #000b, inset 0 1px 0 #dfedff26, inset 0 -1px 0 #a4caff08;
 }
 .admin-shell { position: relative; isolation: isolate; min-height: 100vh; background: var(--background); }
-.admin-shell::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(ellipse at 8% 0%, #79c91416, transparent 45%), radial-gradient(ellipse at 98% 25%, #41967b14, transparent 50%); }
-.dark .admin-shell::before { background: radial-gradient(ellipse at 8% 0%, #4278b018, transparent 45%), radial-gradient(ellipse at 98% 25%, #577aa512, transparent 50%); }
-.dark .admin-shell .admin-overview-header { background-image: linear-gradient(115deg, #6292c40b, transparent 65%); }
+/* Static light fields provide visible depth through the glass without animation. */
+.admin-shell::before { content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(ellipse 720px 560px at 3% 5%, #a2c4ee72, transparent 75%), radial-gradient(ellipse 680px 620px at 95% 35%, #bec6ed80, transparent 75%), radial-gradient(ellipse 600px 500px at 30% 100%, #b8d5e56b, transparent 75%); }
+.dark .admin-shell::before { background: radial-gradient(ellipse 760px 600px at 0% 0%, #3e6eac66, transparent 75%), radial-gradient(ellipse 680px 640px at 100% 38%, #52699b48, transparent 75%), radial-gradient(ellipse 620px 480px at 35% 100%, #28516e48, transparent 75%); }
+.admin-shell::after { content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none; background-image: linear-gradient(#5d83ad0a 1px, transparent 1px), linear-gradient(90deg, #5d83ad0a 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(#0008, transparent 80%); }
+.dark .admin-shell::after { background-image: linear-gradient(#d3e4ff06 1px, transparent 1px), linear-gradient(90deg, #d3e4ff06 1px, transparent 1px); }
 .admin-main { position: relative; }
 .admin-glass, .admin-toolbar, .admin-sidebar {
   background: var(--admin-solid);
@@ -73,7 +79,7 @@
   box-shadow: var(--admin-shadow);
 }
 @supports ((backdrop-filter: blur(8px)) or (-webkit-backdrop-filter: blur(8px))) {
-  .admin-glass, .admin-toolbar, .admin-sidebar { background: var(--admin-glass); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
+  .admin-glass, .admin-toolbar, .admin-sidebar { background: linear-gradient(135deg, var(--admin-glass-sheen), transparent 48%), var(--admin-glass); border-color: var(--admin-glass-edge); backdrop-filter: blur(16px) saturate(135%); -webkit-backdrop-filter: blur(16px) saturate(135%); }
 }
 .admin-glass { border-radius: 22px; }
 .admin-toolbar { border-radius: 20px; }
@@ -95,13 +101,14 @@
 .admin-shell .admin-kpi:hover { transform: translateY(-3px); border-color: var(--ring); box-shadow: 0 20px 34px -24px #17372166, inset 0 1px 0 #ffffff22; }
 .admin-shell .admin-kpi:active { transform: translateY(-1px); }
 .admin-kpi-icon { border: 1px solid var(--border); background: linear-gradient(145deg, var(--muted), var(--card)); box-shadow: inset 0 1px 0 #ffffff25, 0 3px 7px -5px #0008; }
-.admin-shell .admin-overview-header { background-image: linear-gradient(115deg, #79c9140e, transparent 65%); }
+.admin-shell .admin-overview-header { border-top-color: var(--admin-glass-edge); }
 .admin-shell [data-testid="dashboard-clock"] { width: auto; flex-shrink: 0; max-width: 160px; gap: 4px; }
 .admin-shell [data-testid="dashboard-clock"] > svg { width: 82px; height: 82px; }
 .admin-shell [data-testid="dashboard-clock"] > p { font-size: 10px; max-width: 145px; }
 .admin-shell [data-testid="dashboard-clock"] > span { font-size: 8px; letter-spacing: .08em; }
 .admin-expandable[open] > .admin-expandable-content { animation: admin-panel-in 160ms ease-out both; }
 @keyframes admin-panel-in { from { opacity: 0; transform: translateY(-3px); } to { opacity: 1; transform: translateY(0); } }
+@supports ((backdrop-filter: blur(8px)) or (-webkit-backdrop-filter: blur(8px))) { @media (max-width: 639px) { .admin-glass, .admin-toolbar, .admin-sidebar { backdrop-filter: blur(10px) saturate(120%); -webkit-backdrop-filter: blur(10px) saturate(120%); } } }
 @media (min-width: 640px) { .admin-shell [data-testid="dashboard-clock"] > svg { width: 96px; height: 96px; } }
 @media (max-width: 420px) { .admin-shell [data-testid="dashboard-clock"] > svg { width: 64px; height: 64px; } .admin-shell [data-testid="dashboard-clock"] { max-width: 106px; } }
 @media (prefers-reduced-motion: reduce) {
