# AI Customer Center: credentials stay on the server
OPENAI_API_KEY=
OPENAI_MODEL=
META_APP_ID=2010881339552808
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
