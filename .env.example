CRON_SECRET=

# Keep aliases identical within each environment
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-the-same-long-random-auth-secret
EMAIL_CONFIG_ENCRYPTION_KEY=
# SMTP_PASSWORD and EMAIL_FROM remain supported legacy aliases. Prefer SMTP_PASS / MAIL_FROM.
