ADMIN_NOTIFICATION_EMAILS=admin@example.com
LEAD_NOTIFICATION_EMAILS=admin-one@example.com,admin-two@example.com
NEXT_PUBLIC_SITE_URL=https://visionsecuretech.in

# Optional notification channels and analytics
RESEND_API_KEY=
ADMIN_NOTIFICATION_WHATSAPP=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
