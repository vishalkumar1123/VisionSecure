+const assert=require('node:assert/strict'),fs=require('node:fs'),path=require('node:path'),vm=require('node:vm'),test=require('node:test'),ts=require('typescript'),React=require('react')
+const {renderToStaticMarkup}=require('react-dom/server'),cache=new Map()
+function load(name){const file=path.resolve(name);if(cache.has(file))return cache.get(file);if(file.endsWith('.json'))return JSON.parse(fs.readFileSync(file,'utf8'));const source=ts.transpileModule(fs.readFileSync(file,'utf8'),{compilerOptions:{module:ts.ModuleKind.CommonJS,target:ts.ScriptTarget.ES2022,jsx:ts.JsxEmit.ReactJSX,esModuleInterop:true}}).outputText;const mod={exports:{}};const req=n=>{if(!n.startsWith('@/')&&!n.startsWith('.'))return require(n);const base=n.startsWith('@/')?path.resolve(n.slice(2)):path.resolve(path.dirname(file),n);return load([base,base+'.ts',base+'.tsx',base+'.json'].find(p=>fs.existsSync(p)&&fs.statSync(p).isFile()))};vm.runInThisContext(`(function(require,module,exports){${source}\n})`,{filename:file})(req,mod,mod.exports);cache.set(file,mod.exports);return mod.exports}
+const {parseArticle,safeArticleHref}=load('lib/article-content.ts'),{ArticleContent}=load('components/article-content.tsx'),{blogPosts}=load('lib/blogs.ts'),{services}=load('lib/services.ts'),{serviceContent}=load('lib/service-content.ts'),{articleSchema,breadcrumbSchema,BUSINESS_ID}=load('lib/schema.ts')
+const render=content=>renderToStaticMarkup(React.createElement(ArticleContent,{content}))
+test('BHK headings and repeated Office labels never consume their following paragraphs',()=>{const html=render('### 1 BHK Home\nFirst detail must remain.\n\nOffice\nFirst recommendation.\n\nOffice\nSecond recommendation.');for(const text of ['First detail must remain.','First recommendation.','Second recommendation.'])assert(html.includes(text));assert.equal((html.match(/Office/g)||[]).length,2)})
+test('tables, lists, safe links and escaped text render as semantic content',()=>{const html=render('## Compare\n| Type | Check |\n| --- | --- |\n| WiFi | Power |\n\n1. Plan\n2. Test\n\n- Label\n- Record\n\n[Service](/services/cctv-surveillance) and [bad](javascript:alert(1)) <script>alert(2)</script>');for(const tag of ['<table','<thead','scope="col"','scope="row"','<ol','<ul','href="/services/cctv-surveillance"'])assert(html.includes(tag));assert(!html.includes('<script>'));assert(!html.includes('href="javascript:'));assert(html.includes('&lt;script&gt;'));for(const value of ['//evil.test','/\t/evil.test','javascript:alert(1)','data:text/html,x'])assert.equal(safeArticleHref(value),null)})
+test('all seven article sources retain their meaningful lines; malformed table rows are not dropped',()=>{assert.equal(blogPosts.length,7);for(const post of blogPosts){const flat=parseArticle(post.content).flatMap(b=>b.type==='paragraph'||b.type==='heading'?[b.text]:b.type==='list'?b.items:b.type==='table'?[...b.headers,...b.rows.flat()]:[]).join(' ').replace(/\s+/g,' ');for(const line of post.content.split('\n').map(l=>l.trim()).filter(l=>l&&l!=='---'&&!l.includes('|'))){const expected=line.replace(/^#{2,3}\s+|^[-*\u2022\u2714\u2713]\s+|^\d+[.)]\s+/,'');assert(flat.includes(expected),post.slug+': '+line)}}assert(render('| A | B |\n| --- | --- |\n| one | two | three |').includes('three'))})
+test('13 real services have distinct component and benefit explanations',()=>{assert.deepEqual(Object.keys(serviceContent).sort(),services.map(s=>s.slug).sort());const descriptions=[];for(const service of services){const data=serviceContent[service.slug];assert.equal(data.components.length,4);assert.equal(data.benefits.length,service.benefits.length);descriptions.push(...data.components.map(x=>x.description),...data.benefits)}assert.equal(new Set(descriptions).size,descriptions.length);assert(serviceContent['access-control-system'].components.some(c=>c.description.includes('revocation')));assert(serviceContent['biometric-attendance'].benefits.some(t=>t.includes('separate function')))})
+test('article and breadcrumb schema use visible data and the existing publisher without invented dates or authors',()=>{for(const article of blogPosts){const data=articleSchema(article);assert.equal(data.headline,article.title);assert.equal(data.publisher['@id'],BUSINESS_ID);assert(!('dateModified' in data));assert(!('author' in data));const crumb=breadcrumbSchema('/blog/'+article.slug,[{name:'Home',path:'/'},{name:'Blog',path:'/blog'},{name:article.title,path:'/blog/'+article.slug}]);assert.equal(crumb.itemListElement[2].position,3);assert.equal(crumb.itemListElement[2].item,'https://visionsecuretech.in/blog/'+article.slug)}})
